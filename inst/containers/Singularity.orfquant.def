Bootstrap: docker
From: bioconductor/bioconductor_docker:RELEASE_3_20

%labels
    Author wtbxsjy <wtbxsjy@hotmail.com>
    Version 1.3.2
    Description ORFquant 1.3.2 — Splice-aware Quantification of ORF translation
    R_Version 4.4+

%setup
    ROOTFS="${SINGULARITY_ROOTFS:-${APPTAINER_ROOTFS}}"
    mkdir -p "${ROOTFS}/etc"
    rm -f "${ROOTFS}/etc/resolv.conf"
    : > "${ROOTFS}/etc/resolv.conf"
    mkdir -p "${ROOTFS}/opt/orfquant"

%files
    # Copy the ORFquant source tree into the container
    ../../ /opt/orfquant

%post
    # =========================================================================
    # System dependencies
    # =========================================================================
    apt-get update -qq && apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        libgit2-dev \
        && rm -rf /var/lib/apt/lists/*

    # =========================================================================
    # Install ORFquant dependencies via BiocManager
    # =========================================================================
    R --vanilla -q -e '
    if (!requireNamespace("BiocManager", quietly = TRUE))
        install.packages("BiocManager", repos = "https://cloud.r-project.org")
    BiocManager::install(c(
        "rtracklayer", "BSgenome", "Biostrings", "GenomicFeatures",
        "multitaper", "GenomicAlignments", "GenomicFiles",
        "ggplot2", "cowplot", "gridExtra", "knitr", "rmarkdown",
        "BiocParallel", "GenomicRanges", "Rsamtools", "tidyr",
        "BiocGenerics", "devtools", "testthat"
    ), update = FALSE, ask = FALSE)
    '

    # =========================================================================
    # Install ORFquant from local source
    # =========================================================================
    R --vanilla -q -e '
    pkg_dir <- "/opt/orfquant"
    if (!dir.exists(pkg_dir)) stop("ORFquant source not found at: ", pkg_dir)
    message("Installing ORFquant from: ", pkg_dir)
    status <- system(sprintf("R CMD INSTALL %s", shQuote(pkg_dir)))
    if (status != 0) stop("R CMD INSTALL failed with status ", status)

    # Verify
    library(ORFquant)
    message("ORFquant version: ", packageVersion("ORFquant"))
    message("Installation OK")
    '

    # =========================================================================
    # Cleanup
    # =========================================================================
    rm -rf /opt/orfquant
    apt-get clean

%environment
    export R_LIBS_USER=/usr/local/lib/R/site-library

%runscript
    exec "$@"

%help
    ORFquant 1.3.2 — Splice-aware Quantification of ORF translation

    Modernization changes (v1.3.2):
      - R >= 4.0.0 required
      - S4 slot access (@ranges, @strand, @width, etc.) → accessor functions
      - dim()[1]/[2] → nrow()/ncol()
      - Redundant stringsAsFactors = FALSE removed from data.frame()
      - c() accumulation in loops → pre-allocation
      - sapply() → vapply() for type-stable mapping
      - base ifelse() → dplyr::if_else()
      - DPSS caching infrastructure

    Performance optimizations (v1.3.0+):
      - DPSS Slepian caching: 3-34x speedup in spectral analysis
      - Vectorized calc_orf_pval: batch P-site extraction
      - Early filtering: skip non-qualifying ORFs before expensive computation
      - Memory pre-allocation: reduced dynamic vector growth overhead

    Build:
        apptainer build --fakeroot -F orfquant_1.3.2.sif \\
            inst/containers/Singularity.orfquant.def

    Usage:
        apptainer exec orfquant_1.3.2.sif Rscript your_script.R
        apptainer exec orfquant_1.3.2.sif R
