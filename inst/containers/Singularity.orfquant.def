Bootstrap: docker
From: bioconductor/bioconductor_docker:RELEASE_3_20

%labels
    Author wtbxsjy <wtbxsjy@hotmail.com>
    Version 1.3.2
    Description ORFquant 1.3.2 + RiboseQC — Ribo-seq ORF quantification and QC
    R_Version 4.4+

%setup
    ROOTFS="${SINGULARITY_ROOTFS:-${APPTAINER_ROOTFS}}"
    mkdir -p "${ROOTFS}/etc"
    mkdir -p "${ROOTFS}/opt/orfquant"
    # Copy host DNS for network access during build
    cp /etc/resolv.conf "${ROOTFS}/etc/resolv.conf"
    # Copy only files needed for R CMD INSTALL (much faster than %files via FUSE)
    cp -r "${PWD}/DESCRIPTION" "${ROOTFS}/opt/orfquant/"
    cp -r "${PWD}/NAMESPACE"  "${ROOTFS}/opt/orfquant/"
    cp -r "${PWD}/R"          "${ROOTFS}/opt/orfquant/"
    cp -r "${PWD}/man"        "${ROOTFS}/opt/orfquant/"
    cp -r "${PWD}/inst"       "${ROOTFS}/opt/orfquant/"

%post
    # =========================================================================
    # System dependencies (mostly already in bioconductor_docker image)
    # =========================================================================
    apt-get update -qq && apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev \
        libssl-dev \
        libgit2-dev \
        && rm -rf /var/lib/apt/lists/*

    # =========================================================================
    # Install remaining deps not in base bioconductor_docker image
    # =========================================================================
    R --vanilla -q -e '
    if (!requireNamespace("BiocManager", quietly = TRUE))
        install.packages("BiocManager", repos = "https://cloud.r-project.org")
    BiocManager::install(c(
        "rtracklayer", "BSgenome", "Biostrings", "GenomicFeatures",
        "GenomicAlignments", "GenomicFiles", "BiocGenerics",
        "BiocParallel", "GenomicRanges", "Rsamtools", "tidyr",
        "multitaper", "cowplot", "gridExtra", "dplyr"
    ), update = FALSE, ask = FALSE)
    '

    # =========================================================================
    # Install ORFquant from local source
    # =========================================================================
    R CMD INSTALL /opt/orfquant

    # Verify
    R --vanilla -q -e 'library(ORFquant); message("ORFquant ", packageVersion("ORFquant"))'

    # =========================================================================
    # Install RiboseQC (from GitHub, R 4.2+ compatible fork)
    # =========================================================================
    R --vanilla -q -e '
    # RiboseQC CRAN/BioC dependencies
    pkgs <- c("devtools", "ggpubr", "reshape2", "ade4", "foreach", "doMC",
              "seqinr", "viridis", "R.methodsS3", "iterators", "jsonlite",
              "xfun", "knitr", "rmarkdown")
    for (pkg in pkgs) {
      if (!requireNamespace(pkg, quietly = TRUE))
        install.packages(pkg, repos = "https://cloud.r-project.org")
    }
    # RiboseQC R 4.2+ compatible fork (fixes GenomicFeatures compatibility)
    devtools::install_github("hsinyemwu/RiboseQC_R4.2.1", upgrade = "never")
    '

    # Verify RiboseQC
    R --vanilla -q -e 'library(RiboseQC); message("RiboseQC installed OK")'

    # =========================================================================
    # Cleanup
    # =========================================================================
    rm -rf /opt/orfquant
    apt-get clean

%environment
    export R_LIBS_USER=/usr/local/lib/R/site-library

%runscript
    exec "$@"

%help
    ORFquant 1.3.2 + RiboseQC — Ribo-seq ORF quantification and QC

    Included packages:
      - ORFquant 1.3.2  — Splice-aware Quantification of ORF translation
      - RiboseQC        — Quality Control of Ribo-seq data, P-site offset selection

    ORFquant modernization (v1.3.2):
      - R >= 4.0.0 required
      - S4 slot access → accessor functions (ranges(), strand(), width(), etc.)
      - dim()[1]/[2] → nrow()/ncol()
      - c() accumulation in loops → pre-allocation
      - sapply() → vapply() for type-stable mapping
      - DPSS caching: 3-34x speedup

    Build:
        apptainer build --fakeroot -F orfquant_1.3.2.sif \\
            inst/containers/Singularity.orfquant.def

    Usage:
        apptainer exec orfquant_1.3.2.sif Rscript your_script.R
        apptainer exec orfquant_1.3.2.sif R
